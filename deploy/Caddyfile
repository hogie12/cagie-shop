{
	# Let's Encrypt sends certificate notices here.
	email {$ACME_EMAIL}
}

# Caddy gets and renews the HTTPS certificate by itself. The domain's DNS must
# already point at this server when Caddy starts.
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy replaces any X-Forwarded-For a visitor sends with the visitor's
	# real IP, and the gateway trusts that header from Caddy only.
	reverse_proxy gateway:8080
}
